# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# Set to True ONLY on your own computer.
DEBUG=True

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# ---- PostgreSQL connection string (pick ONE) ----
# Local PostgreSQL:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# Supabase (Project -> Connect -> copy the URI; use the *Session pooler* string for Render):
#   DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Render PostgreSQL (use the "External Database URL" locally, "Internal" when deployed on Render):
#   DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx-a.REGION-postgres.render.com/DBNAME

# SSL is enabled automatically for non-local hosts. Override only if needed (true/false):
# DATABASE_SSL_REQUIRE=true
# Only if you use Supabase's *Transaction* pooler (port 6543):
# DATABASE_USING_TRANSACTION_POOLER=true

# Comma-separated. On Render the service's own hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Needed only if you use /admin/ on a custom domain (https://...).
# CSRF_TRUSTED_ORIGINS=https://api.example.com
